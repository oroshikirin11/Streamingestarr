# This host's tailscale IP — RTMP/SRT/metadata bind here, never the public internet.
TAILNET_IP=100.124.204.59

# Uncomment to take SRT ingest over the public internet instead of the
# tunnel (avoids WireGuard's 1280 MTU fragmenting SRT's 1316-byte payloads).
# Open 9710/udp in the host/cloud firewall too. RTMP and metadata stay
# tailnet-bound regardless.
# SRT_BIND_IP=0.0.0.0
